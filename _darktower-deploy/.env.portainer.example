# ScrapeGraphAI Server — Environment Variables
# Copy this file to .env.portainer on Darktower and fill in values.
# .env.portainer is gitignored. This file is safe to commit.

# Default Ollama base URL — callers can override per-request, but setting this
# here means they don't have to pass base_url every time for local Ollama use.
DEFAULT_OLLAMA_BASE_URL=

# Server-side fallback API keys — callers can pass their own keys per-request,
# but these are used when no key is provided in the request body.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
