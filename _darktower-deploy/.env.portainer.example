# ScrapeGraphAI Server — Environment Variables
# Copy this file to .env.portainer on Darktower and fill in values.
# .env.portainer is gitignored. This file is safe to commit.

# ── Default LLM (used when a request omits provider/model) ───────────────────
# Project default: gemma4:12b (alias "ocr", think:false) via the DarkTower
# LiteLLM gateway. Callers may still override any of these per-request.
LLM_PROVIDER=openai
LLM_MODEL=ocr
LLM_MODEL_TOKENS=128000

# OpenAI-compatible endpoint. Point at the LiteLLM gateway (host LAN IP from a
# container). Leave OPENAI_BASE_URL empty to use real OpenAI instead.
OPENAI_BASE_URL=http://192.168.2.125:51366/v1
OPENAI_API_KEY=        # LiteLLM project virtual key (mint per project; gitignored)

# Default Ollama base URL — used only for provider=ollama requests (direct Ollama,
# bypassing the gateway). Callers can override per-request.
DEFAULT_OLLAMA_BASE_URL=http://192.168.2.125:11434

# Server-side fallback key for provider=anthropic requests.
ANTHROPIC_API_KEY=
